# CF Bossnusilelo V.2 Environment Variables
# ตั้งค่าค่าจริงใน Vercel Project Settings → Environment Variables

# 🔐 Admin API — ต้องยาวอย่างน้อย 32 ตัวอักษร
# สร้างด้วย: openssl rand -hex 32
ADMIN_TOKEN=replace-with-a-long-random-secret

# 🤖 AI provider used by api/chat.js
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Optional chat defaults
PERSONA=คุณคือสลี่ ผู้ช่วยอัจฉริยะที่น่ารัก อ่อนหวาน พูดจาเข้าใจง่าย ใช้ภาษาไทยเป็นหลัก เรียกผู้ใช้ว่า "ที่รัก" เสมอ
