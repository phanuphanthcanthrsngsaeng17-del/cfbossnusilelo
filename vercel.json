{
  "buildCommand": "npm install",
  "outputDirectory": "public",
  "framework": null,
  "installCommand": "npm install",
  "routes": [
    { "src": "/", "dest": "/public/chat-v2.html" },
    { "src": "/api/chat", "dest": "/api/chat.js" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/chat/(.*)", "dest": "/public/chat-v2.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}