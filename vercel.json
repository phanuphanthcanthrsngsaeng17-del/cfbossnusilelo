{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/", "destination": "/sandbox-room.html" },
    { "source": "/chat/:path*", "destination": "/sandbox-room.html" },
    { "source": "/fleet", "destination": "/sandbox-room.html" },
    { "source": "/sandbox", "destination": "/sandbox-room.html" },
    { "source": "/code", "destination": "/sandbox-room.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    }
  ]
}